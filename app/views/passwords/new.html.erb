<% content_for :title, "Forgot your password? · Stockroom" %>

<section class="card narrow">
  <h1>Forgot your password?</h1>

  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <%= form.submit "Email reset instructions", class: "button" %>
  <% end %>
</section>
